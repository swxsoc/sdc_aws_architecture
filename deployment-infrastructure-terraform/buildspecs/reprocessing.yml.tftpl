version: 0.2

env:
  shell: bash

phases:
  install:
    commands:
      - |
        set -euo pipefail
        BANNER_SOURCE=$${CODEBUILD_WEBHOOK_TRIGGER:-$${CODEBUILD_SOURCE_VERSION:-manual}}
        BANNER_PROJECT=$${CODEBUILD_BUILD_ID%%:*}
        BANNER_COMMIT=$${CODEBUILD_RESOLVED_SOURCE_VERSION:-unknown}
        printf '\n%s\n' '================================================================================'
        printf '  SWxSOC BUILD: REPROCESSING REQUESTS\n'
        printf '%s\n' '================================================================================'
        printf '  Environment : Shared\n'
        printf '  Mission     : ${mission}\n'
        printf '  Service     : reprocessing\n'
        printf '  Action      : process newly added request JSON files\n'
        printf '  Project     : %s\n' "$${BANNER_PROJECT:-local}"
        printf '  Build       : %s\n' "$${CODEBUILD_BUILD_NUMBER:-local}"
        printf '  Trigger     : %s\n' "$BANNER_SOURCE"
        printf '  Source ref  : %s\n' "$${CODEBUILD_SOURCE_VERSION:-unknown}"
        printf '  Commit      : %.12s\n' "$BANNER_COMMIT"
        printf '%s\n\n' '================================================================================'
      - python3 -m pip install -r requirements.txt

  pre_build:
    commands:
      - export PYTHONPATH="$PYTHONPATH:$(pwd)/scripts"
      - |
        set -euo pipefail
        echo "Identifying newly added request files..."
        if git rev-parse HEAD^ >/dev/null 2>&1; then
          ADDED_FILES=$(git diff --name-only HEAD^ HEAD --diff-filter=A)
        else
          ADDED_FILES=$(git show --pretty='' --name-only --diff-filter=A HEAD)
        fi
        FILTERED_FILES=$(printf '%s\n' "$ADDED_FILES" | awk '/^requests\/.*\.json$/ && $0 !~ /^requests\/submit\//')
        printf 'Filtered files:\n%s\n' "$${FILTERED_FILES:-None}"

        if [ -n "$FILTERED_FILES" ]; then
          printf '%s\n' "$FILTERED_FILES" | python3 scripts/process_files.py
        else
          echo "No JSON files found in requests/ (excluding submit)"
        fi
